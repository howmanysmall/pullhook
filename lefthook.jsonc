{
	"commit-msg": {
		"jobs": [
			{
				"name": "commitlint",
				"run": "aube run commitlint -- --edit {1}",
				"skip": ["merge", "rebase"],
			},
		],
	},
	"min_version": "2.1.6",
	"post-merge": {
		"jobs": [
			{
				"name": "package-install",
				"run": "aube install",
			},
		],
	},
	"pre-commit": {
		"jobs": [
			{
				"group": {
					"jobs": [
						{
							"glob": ["**/*.json", "**/*.jsonc"],
							"name": "biome-fix",
							"run": "biome check --write --no-errors-on-unmatched {staged_files}",
							"stage_fixed": true,
						},
						{
							"glob": [
								"**/*.js",
								"**/*.jsx",
								"**/*.ts",
								"**/*.tsx",
								"**/*.mjs",
								"**/*.mts",
								"**/*.cjs",
								"**/*.cts",
								"**/*.css",
								"**/*.html",
								"**/*.graphql",
								"**/*.gql",
								"**/*.yaml",
								"**/*.yml",
							],
							"name": "oxfmt",
							"run": "oxfmt {staged_files}",
							"stage_fixed": true,
						},
						{
							"glob": "**/*.md",
							"name": "rumdl-fix",
							"run": "rumdl fmt {staged_files}\nrumdl check {staged_files}\n",
							"stage_fixed": true,
						},
						{
							"glob": "**/*.toml",
							"name": "tombi-fix",
							"run": "tombi format {staged_files}\ntombi lint {staged_files}\n",
							"stage_fixed": true,
						},
						{
							"glob": "**/*.rs",
							"name": "rustfmt",
							"run": "cargo fmt -- {staged_files}",
							"stage_fixed": true,
						},
					],
					"parallel": true,
				},
			},
			{
				"group": {
					"jobs": [
						{
							"glob": ["**/*.json", "**/*.jsonc"],
							"name": "oxfmt-json",
							"run": "oxfmt {staged_files}",
							"stage_fixed": true,
						},
					],
				},
			},
			{
				"group": {
					"jobs": [
						{
							"name": "audit",
							"run": "cargo audit --quiet",
						},
						{
							"name": "clippy",
							"run": "cargo clippy --all-targets -- -D warnings",
						},
						{
							"name": "deny",
							"run": "cargo deny check",
						},
						{
							"name": "shear",
							"run": "cargo shear",
						},
						{
							"name": "gitleaks",
							"run": "gitleaks protect --staged",
						},
					],
					"parallel": true,
				},
			},
		],
	},
	"pre-push": {
		"jobs": [
			{
				"name": "test",
				"run": "cargo nextest run --no-tests=pass",
			},
		],
	},
}
