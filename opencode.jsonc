{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"ask": {
			"model": "openai/gpt-5.4",
			"temperature": 0,
		},
		"build": {
			"description": "Used after creating a plan or just whenever.",
			"mode": "all",
			"model": "openai/gpt-5.4",
			"permission": {
				"bash": {
					"*": "ask",
					"bat *": "allow",
					"cat *": "allow",
					"cd *": "allow",
					"delta *": "allow",
					"diff *": "allow",
					"du *": "allow",
					"dust *": "allow",
					"exa *": "allow",
					"fd *": "allow",
					"find *": "allow",
					"git diff*": "allow",
					"git status*": "allow",
					"grep *": "allow",
					"ls *": "allow",
					"lsd *": "allow",
					"peekaboo *": "allow",
					"rg *": "allow",
					"sd *": "allow",
					"sed *": "allow",
				},
				"codesearch": "allow",
				"doom_loop": "ask",
				"edit": "allow",
				"external_directory": "ask",
				"glob": "allow",
				"grep": "allow",
				"list": "allow",
				"lsp": "allow",
				"question": "allow",
				"read": "allow",
				"skill": "allow",
				"task": "allow",
				"todoread": "allow",
				"todowrite": "allow",
				"webfetch": "allow",
				"websearch": "allow",
			},
		},
		"plan": {
			"description": "Used to generate a plan.",
			"mode": "all",
			"model": "openai/gpt-5.4",
			"permission": {
				"bash": {
					"*": "ask",
					"bat *": "allow",
					"cat *": "allow",
					"cd *": "allow",
					"delta *": "allow",
					"diff *": "allow",
					"du *": "allow",
					"dust *": "allow",
					"exa *": "allow",
					"fd *": "allow",
					"find *": "allow",
					"git diff*": "allow",
					"git status*": "allow",
					"grep *": "allow",
					"ls *": "allow",
					"lsd *": "allow",
					"rg *": "allow",
					"sd *": "allow",
					"sed *": "allow",
				},
				"codesearch": "allow",
				"doom_loop": "ask",
				"edit": "deny",
				"external_directory": "ask",
				"glob": "allow",
				"grep": "allow",
				"list": "allow",
				"lsp": "allow",
				"question": "allow",
				"read": "allow",
				"task": "allow",
				"todoread": "allow",
				"todowrite": "allow",
				"webfetch": "ask",
				"websearch": "allow",
			},
		},
	},
	"experimental": {
		"batch_tool": true,
	},
	"formatter": {
		"biome": {
			"command": ["aube", "run", "biome", "check", "--write", "$FILE"],
			"disabled": false,
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"rumdl": {
			"command": ["rumdl", "check", "--fix", "$FILE"],
			"disabled": false,
			"extensions": [
				".md",
				".markdown",
				".mdown",
				".mkdn",
				".mkd",
				".mdwn",
				".mdtxt",
				".mdtext",
				".text",
				".Rmd",
			],
		},
		"tombi": {
			"command": ["tombi", "format", "$FILE"],
			"disabled": false,
			"extensions": [".toml"],
		},
	},
	"instructions": ["./AGENTS.md"],
	"layout": "stretch",
	"lsp": {
		"biome": {
			"command": ["aube", "run", "biome", "lsp-proxy"],
			"disabled": false,
			"env": {},
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"rumdl": {
			"command": ["rumdl", "server"],
			"disabled": false,
			"extensions": [
				".md",
				".markdown",
				".mdown",
				".mkdn",
				".mkd",
				".mdwn",
				".mdtxt",
				".mdtext",
				".text",
				".Rmd",
			],
		},
		"rust-analyzer": {
			"command": ["rust-analyzer"],
			"disabled": false,
			"extensions": [".rs"],
		},
		"tombi": {
			"command": ["tombi", "lsp"],
			"disabled": false,
			"extensions": [".toml"],
		},
	},
	"mcp": {
		"context7": {
			"enabled": true,
			"headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
		},
		"gh-grep": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.grep.app",
		},
		"package-registry": {
			"command": ["bun", "x", "--bun", "package-registry-mcp"],
			"enabled": true,
			"type": "local",
		},
	},
	"permission": {
		"bash": {
			"*": "ask",
			"bat *": "allow",
			"cargo build *": "allow",
			"cargo check *": "allow",
			"cargo clippy *": "allow",
			"cargo doc *": "allow",
			"cargo run *": "allow",
			"cargo test *": "allow",
			"cat *": "allow",
			"cd *": "allow",
			"delta *": "allow",
			"diff *": "allow",
			"du *": "allow",
			"dust *": "allow",
			"exa *": "allow",
			"fd *": "allow",
			"find *": "allow",
			"grep *": "allow",
			"ls *": "allow",
			"lsd *": "allow",
			"rg *": "allow",
			"sd *": "allow",
			"sed *": "allow",
		},
		"doom_loop": "ask",
		"edit": "ask",
		"external_directory": "ask",
		"skill": "ask",
		"webfetch": "ask",
	},
	"plugin": ["opencode-wakatime"],
	"username": "pullhook",
}
